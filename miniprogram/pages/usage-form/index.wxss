page {
  background-color: #fff7f9;
  min-height: 100vh;
}

.form-container {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.header {
  background: #e58fa8;
  padding: 60rpx 80rpx 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0;
  position: relative;
}

.day-badge {
  position: absolute;
  top: 40rpx;
  right: 40rpx;
  background: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(10rpx);
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.header-icon {
  width: 92rpx;
  height: 92rpx;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.header-phone {
  width: 42rpx;
  height: 66rpx;
  border: 5rpx solid #fff;
  border-radius: 10rpx;
  position: relative;
  box-sizing: border-box;
}

.phone-speaker {
  position: absolute;
  top: 6rpx;
  left: 50%;
  width: 15rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: rgba(255, 255, 255, 0.82);
  transform: translateX(-50%);
}

.phone-home {
  position: absolute;
  bottom: 5rpx;
  left: 50%;
  width: 5rpx;
  height: 5rpx;
  border-radius: 50%;
  background: #fff;
  transform: translateX(-50%);
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-align: center;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.progress-section {
  margin-top: 32rpx;
  width: 100%;
  max-width: 500rpx;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ffd700 0%, #ffb347 100%);
  border-radius: 4rpx;
  transition: width 0.5s ease-out;
}

.progress-info {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
}

.form-content {
  padding: 0 32rpx;
  margin-top: 40rpx;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(213, 111, 145, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #e58fa8;
}

.intro-title {
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.6;
}

.intro-number {
  color: #c95f82;
  font-size: 26rpx;
  margin: 12rpx 0 20rpx;
}

.intro-text,
.consent-text,
.closing-thanks {
  color: #555;
  font-size: 28rpx;
  line-height: 1.8;
}

.video-title {
  margin: 28rpx 0 20rpx;
  color: #333;
  font-size: 30rpx;
  font-weight: 600;
}

.video-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  color: #666;
  font-size: 25rpx;
}

.video-count {
  flex-shrink: 0;
  color: #c95f82;
  font-weight: 600;
}

.video-picker {
  height: 420rpx;
  border: 2rpx solid #f3d7df;
  border-radius: 16rpx;
  background: #fff9fb;
  box-sizing: border-box;
}

.video-choice {
  min-height: 82rpx;
  padding: 14rpx 18rpx;
  border-bottom: 2rpx solid #f6e8ec;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.video-choice:last-child {
  border-bottom: none;
}

.video-choice-index {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  background: #f8cfda;
  color: #b84f73;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.video-choice-title {
  flex: 1;
  min-width: 0;
  color: #444;
  font-size: 26rpx;
  line-height: 1.4;
}

.video-choice-state {
  flex-shrink: 0;
  color: #c95f82;
  font-size: 23rpx;
}

.video-choice.selected {
  background: #fff0f4;
}

.video-choice.selected .video-choice-index {
  background: #e58fa8;
  color: #fff;
}

.video-choice.watched {
  background: #f7f7f7;
  opacity: 0.68;
}

.video-choice.watched .video-choice-index {
  background: #e4e4e4;
  color: #888;
}

.video-choice.watched .video-choice-state {
  color: #888;
}

.intervention-video {
  width: 100%;
  height: 360rpx;
  background: #111;
  border-radius: 12rpx;
}

.video-loading,
.video-status {
  color: #777;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
}

.video-status {
  margin-top: 18rpx;
}

.video-status.completed {
  color: #2f855a;
  font-weight: 600;
}

.retry-video-btn {
  width: 100%;
  color: #c95f82;
  background: #fff0f4;
  font-size: 28rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.item-label {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.label-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.label-text {
  font-size: 28rpx;
  color: #555;
  font-weight: 500;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f8f9fc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 88rpx;
  border: 2rpx solid #e8ecf1;
  transition: border-color 0.3s;
}

.input-wrapper:focus-within {
  border-color: #e58fa8;
  background: #fff;
}

.form-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 100%;
}

.input-unit {
  font-size: 26rpx;
  color: #999;
  margin-left: 12rpx;
}

.second-input {
  margin-top: 16rpx;
}

.choice-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.choice-pill,
.option-item {
  min-height: 72rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e8ecf1;
  background: #f8f9fc;
  color: #555;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.choice-pill.selected,
.option-item.selected {
  border-color: #e58fa8;
  background: rgba(229, 143, 168, 0.14);
  color: #c95f82;
  font-weight: 600;
}

.scale-label {
  align-items: flex-start;
}

.question-no {
  flex-shrink: 0;
  color: #c95f82;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 10rpx;
}

.option-list {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.feedback-input {
  width: 100%;
  min-height: 180rpx;
  box-sizing: border-box;
  background: #f8f9fc;
  border: 2rpx solid #e8ecf1;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.consent-choice {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  color: #555;
  font-size: 28rpx;
}

.checkbox {
  width: 44rpx;
  height: 44rpx;
  margin-right: 16rpx;
  border: 2rpx solid #c9cfda;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
}

.consent-choice.selected .checkbox {
  border-color: #e58fa8;
  background: #e58fa8;
}

.closing-thanks {
  display: flex;
  margin-top: 32rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #eef0f5;
}

.footer {
  position: fixed;
  z-index: 1000;
  bottom: 0;
  left: 0;
  right: 0;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background-color: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
  isolation: isolate;
  transform: translateZ(0);
}

.submit-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #e58fa8 0%, #d56f91 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(213, 111, 145, 0.34);
  transition: transform 0.2s, box-shadow 0.2s;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: scale(0.96);
  box-shadow: 0 6rpx 16rpx rgba(213, 111, 145, 0.34);
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 12rpx;
}

.btn-arrow {
  font-size: 40rpx;
  color: #fff;
}