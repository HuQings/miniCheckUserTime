<view class="form-container">
  <view class="header">
    <view class="day-badge">第{{currentDay}}天</view>
    <view class="header-title">请填写今日短视频使用情况</view>
    <view class="header-subtitle">{{phaseText}}</view>
  </view>

  <view class="form-content">
    <view class="form-section">
      <view class="section-title">休闲娱乐类</view>
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">当日使用频次</text>
        </view>
        <view class="input-wrapper">
          <input 
            class="form-input" 
            type="number" 
            placeholder="请输入" 
            value="{{formData.entertainment.frequency}}"
            bindinput="onFreqChange"
            data-type="entertainment"
            data-field="frequency"
          />
          <text class="input-unit">次</text>
        </view>
      </view>
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">当日使用时长</text>
        </view>
        <view class="input-wrapper">
          <input 
            class="form-input" 
            type="digit" 
            placeholder="请输入" 
            value="{{formData.entertainment.hours}}"
            bindinput="onHoursChange"
            data-type="entertainment"
            data-field="hours"
          />
          <text class="input-unit">小时</text>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">学习工作类</view>
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">当日使用频次</text>
        </view>
        <view class="input-wrapper">
          <input 
            class="form-input" 
            type="number" 
            placeholder="请输入" 
            value="{{formData.learning.frequency}}"
            bindinput="onFreqChange"
            data-type="learning"
            data-field="frequency"
          />
          <text class="input-unit">次</text>
        </view>
      </view>
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">当日使用时长</text>
        </view>
        <view class="input-wrapper">
          <input 
            class="form-input" 
            type="digit" 
            placeholder="请输入" 
            value="{{formData.learning.hours}}"
            bindinput="onHoursChange"
            data-type="learning"
            data-field="hours"
          />
          <text class="input-unit">小时</text>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">社交类</view>
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">当日使用频次</text>
        </view>
        <view class="input-wrapper">
          <input 
            class="form-input" 
            type="number" 
            placeholder="请输入" 
            value="{{formData.social.frequency}}"
            bindinput="onFreqChange"
            data-type="social"
            data-field="frequency"
          />
          <text class="input-unit">次</text>
        </view>
      </view>
      <view class="form-item">
        <view class="item-label">
          <text class="label-text">当日使用时长</text>
        </view>
        <view class="input-wrapper">
          <input 
            class="form-input" 
            type="digit" 
            placeholder="请输入" 
            value="{{formData.social.hours}}"
            bindinput="onHoursChange"
            data-type="social"
            data-field="hours"
          />
          <text class="input-unit">小时</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="submit-btn" bindtap="onSubmit" disabled="{{isSubmitting}}">
      <text class="btn-text">{{isSubmitting ? '保存中...' : '保存并继续'}}</text>
      <text class="btn-arrow" wx:if="{{!isSubmitting}}">→</text>
    </button>
  </view>
</view>