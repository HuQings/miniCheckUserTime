<view class="form-container">
  <view class="header">
    <view class="day-badge">{{dayMeta.phase}}</view>
    <view class="header-icon">📱</view>
    <view class="header-title">{{dayMeta.title}}短视频调查</view>
    <view class="header-subtitle">记录今日短视频使用与体验</view>
    
    <view class="progress-section">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{(currentDay / period) * 100}}%"></view>
      </view>
      <view class="progress-info">进度: {{currentDay}}/{{period}} 天</view>
    </view>
  </view>

  <view class="form-content">
    <view class="form-section" wx:if="{{currentDay === 1}}">
      <view class="section-title">基础信息</view>

      <view class="form-item">
        <view class="item-label"><text class="label-text">性别</text></view>
        <view class="choice-row">
          <view class="choice-pill {{formData.gender === item ? 'selected' : ''}}" wx:for="{{genderOptions}}" wx:key="*this" data-field="gender" data-value="{{item}}" bindtap="onChoiceTap">{{item}}</view>
        </view>
      </view>

      <view class="form-item">
        <view class="item-label"><text class="label-text">年级</text></view>
        <view class="choice-row">
          <view class="choice-pill {{formData.grade === item ? 'selected' : ''}}" wx:for="{{gradeOptions}}" wx:key="*this" data-field="grade" data-value="{{item}}" bindtap="onChoiceTap">{{item}}</view>
        </view>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">短视频使用数据</view>

      <view class="form-item" wx:for="{{usageFields}}" wx:key="title">
        <view class="item-label">
          <text class="label-icon">▶</text>
          <text class="label-text">{{item.title}}</text>
        </view>
        <view class="input-wrapper">
          <input class="form-input" type="number" placeholder="当日使用频次" value="{{formData[item.countField]}}" data-field="{{item.countField}}" bindinput="onInputChange" />
          <text class="input-unit">次</text>
        </view>
        <view class="input-wrapper second-input">
          <input class="form-input" type="digit" placeholder="当日使用时长" value="{{formData[item.hoursField]}}" data-field="{{item.hoursField}}" bindinput="onInputChange" />
          <text class="input-unit">小时</text>
        </view>
      </view>
    </view>

    <view class="form-section" wx:if="{{scaleQuestions.length > 0}}">
      <view class="section-title">短视频使用体验</view>
      <view class="form-item scale-item" wx:for="{{scaleQuestions}}" wx:key="field">
        <view class="item-label scale-label">
          <text class="question-no">{{item.no}}.</text>
          <text class="label-text">{{item.text}}</text>
        </view>
        <view class="option-list">
          <view class="option-item {{formData.scale[item.field] === option.value ? 'selected' : ''}}" wx:for="{{likertOptions}}" wx:for-item="option" wx:key="value" data-field="{{item.field}}" data-value="{{option.value}}" bindtap="onScaleTap">
            {{option.label}}
          </view>
        </view>
      </view>
    </view>

    <view class="form-section" wx:if="{{currentDay === period}}">
      <view class="section-title">方案建议</view>
      <view class="form-item">
        <view class="item-label"><text class="label-text">{{feedbackQuestion}}</text></view>
        <textarea class="feedback-input" placeholder="可选填" value="{{formData.feedback}}" data-field="feedback" bindinput="onInputChange"></textarea>
      </view>
    </view>
  </view>

  <view class="footer">
    <button class="submit-btn" bindtap="onSubmit" disabled="{{isSubmitting}}">
      <text class="btn-text">{{isSubmitting ? '提交中...' : '提交记录'}}</text>
      <text class="btn-arrow" wx:if="{{!isSubmitting}}">→</text>
    </button>
  </view>

  <advice-modal 
    show="{{showModal}}" 
    adviceData="{{adviceData}}"
    period="{{period}}"
    bind:close="onCloseModal"
    bind:retry="onRetry"
    bind:finish="onFinish"
  />
</view>