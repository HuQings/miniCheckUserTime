page {
  background-color: #fff7f9;
  min-height: 100vh;
}

.history-container {
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #e58fa8 0%, #d56f91 100%);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 60rpx 60rpx;
}

.header-icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.header-chart {
  height: 52rpx;
  display: flex;
  align-items: flex-end;
  gap: 9rpx;
}

.header-chart-bar {
  width: 11rpx;
  border-radius: 6rpx 6rpx 2rpx 2rpx;
  background: #fff;
}

.header-chart .bar-short {
  height: 24rpx;
  opacity: 0.68;
}

.header-chart .bar-medium {
  height: 38rpx;
  opacity: 0.84;
}

.header-chart .bar-tall {
  height: 52rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-align: center;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.history-content {
  padding: 0 32rpx;
  margin-top: -40rpx;
}

.stats-section {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(213, 111, 145, 0.1);
  margin: 0;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #c95f82;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.records-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(213, 111, 145, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #e58fa8;
}

.record-item {
  background: #f8f9fc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.record-item:last-child {
  margin-bottom: 0;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-day {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.record-date {
  font-size: 22rpx;
  color: #999;
}

.record-details {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.intervention-record {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid #f3d7df;
  border-radius: 12rpx;
  background: #fff9fb;
}

.intervention-label {
  margin-bottom: 8rpx;
  color: #999;
  font-size: 22rpx;
}

.intervention-title {
  color: #b84f73;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.detail-row:last-child {
  padding-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.record-usage {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.usage-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.usage-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.usage-item {
  flex: 0 0 calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
}

.usage-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.usage-count {
  margin-bottom: 4rpx;
  color: #777;
  font-size: 22rpx;
}

.usage-label {
  font-size: 20rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 32rpx;
  border-radius: 34rpx;
  background: #f8cfda;
  border: 2rpx solid rgba(229, 143, 168, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.empty-document {
  width: 58rpx;
  height: 72rpx;
  padding: 16rpx 12rpx;
  border-radius: 10rpx;
  background: #fff;
  box-shadow: 0 8rpx 20rpx rgba(201, 95, 130, 0.16);
  box-sizing: border-box;
}

.document-line {
  height: 5rpx;
  margin-bottom: 9rpx;
  border-radius: 3rpx;
  background: #e58fa8;
}

.document-line.line-long {
  width: 34rpx;
}

.document-line.line-medium {
  width: 27rpx;
  opacity: 0.78;
}

.document-line.line-short {
  width: 20rpx;
  opacity: 0.58;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.start-btn {
  width: 300rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #e58fa8 0%, #d56f91 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(213, 111, 145, 0.34);
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.96);
}