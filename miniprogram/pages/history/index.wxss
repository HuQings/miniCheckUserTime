page {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.history-container {
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-radius: 0 0 60rpx 60rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-align: center;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
}

.history-content {
  padding: 0 32rpx;
  margin-top: -40rpx;
}

.stats-section {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.08);
  margin: 0 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
}

.records-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #667eea;
}

.record-item {
  background: #f8f9fc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.record-item:last-child {
  margin-bottom: 0;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.record-day {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

.record-date {
  font-size: 22rpx;
  color: #999;
}

.record-score {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #fff;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.score-label {
  font-size: 24rpx;
  color: #666;
}

.score-value {
  font-size: 36rpx;
  font-weight: bold;
}

.score-high {
  color: #4cd964;
}

.score-medium {
  color: #ffd700;
}

.score-low {
  color: #ff3b30;
}

.record-details {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.detail-row:last-child {
  padding-bottom: 0;
}

.detail-label {
  font-size: 24rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.record-usage {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.usage-title {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.usage-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.usage-item {
  flex: 0 0 calc(33.33% - 11rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #f8f9fc;
  border-radius: 12rpx;
}

.usage-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.usage-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 4rpx;
}

.usage-label {
  font-size: 20rpx;
  color: #999;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.start-btn {
  width: 300rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.96);
}