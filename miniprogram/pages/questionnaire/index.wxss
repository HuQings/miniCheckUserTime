.container {
  padding: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #5067ca 100%);
  padding-bottom: 200rpx;
}

.header {
  text-align: center;
  padding: 30rpx 0;
  color: #fff;
}

.day-badge {
  display: inline-block;
  background: #fff;
  color: #667eea;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.header-subtitle {
  font-size: 26rpx;
  opacity: 0.8;
}

.question-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.question-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
  transition: all 0.3s;
}

.option-item.selected {
  background: #f0f4ff;
  border-color: #667eea;
}

.option-item text {
  font-size: 26rpx;
  color: #666;
  margin-left: 15rpx;
}

.option-item.selected text {
  color: #667eea;
  font-weight: 500;
}

.usage-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 20rpx;
}

.usage-category {
  margin-bottom: 30rpx;
}

.category-title {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 15rpx;
}

.category-row {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.category-label {
  font-size: 24rpx;
  color: #666;
  width: 160rpx;
}

.category-input {
  flex: 1;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 12rpx 15rpx;
  font-size: 26rpx;
}

.category-unit {
  font-size: 24rpx;
  color: #999;
  margin-left: 10rpx;
}

.feedback-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.feedback-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 200rpx;
  border: 2rpx solid #ddd;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #667eea 0%, #5067ca 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(102, 126, 234, 0.4);
}

.submit-btn[disabled] {
  opacity: 0.6;
}

.submit-btn::after {
  border: none;
}

.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  margin-right: 12rpx;
}

.btn-arrow {
  font-size: 40rpx;
  color: #fff;
}