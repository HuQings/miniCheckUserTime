<view class="welcome-container">
  <view class="gradient-bg"></view>

  <view class="content">
    <view class="logo-section">
      <view class="phone-icon">
        <view class="phone-inner"></view>
      </view>
      <view class="app-name">短视频依赖评估</view>
      <view class="app-slogan">完成24天评估与干预</view>
    </view>

    <view class="user-info" wx:if="{{hasLogin && userInfo}}">
      <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill"></image>
      <view class="user-name">{{userInfo.nickName}}</view>
      <view class="login-status">✓ 已登录</view>
    </view>

    <view class="checkin-section">
      <view class="section-title">
        <text>24天评估与干预</text>
        <text class="progress-text">{{completedDays}}/{{period}}</text>
      </view>
      <view class="checkin-weeks">
        <view class="week-row" wx:for="{{checkinWeeks}}" wx:for-item="weekItem" wx:key="week">
          <view class="week-label">第{{weekItem.week}}周</view>
          <view class="week-days">
            <view class="checkin-item {{dayItem.completed ? 'completed' : ''}} {{dayItem.current ? 'current' : ''}}" wx:for="{{weekItem.days}}" wx:for-item="dayItem" wx:key="day">
              <view class="day-number">{{dayItem.day}}</view>
              <view class="day-status">
                <text wx:if="{{dayItem.completed}}">✓</text>
                <text wx:elif="{{dayItem.current}}">●</text>
                <text wx:else>○</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="features">
      <view class="feature-item">
        <view class="feature-icon feature-chart">
          <view class="chart-bar bar-one"></view>
          <view class="chart-bar bar-two"></view>
          <view class="chart-bar bar-three"></view>
        </view>
        <view class="feature-text">基线评估</view>
      </view>
      <view class="feature-item">
        <view class="feature-icon feature-light">
          <view class="light-head"></view>
          <view class="light-base"></view>
        </view>
        <view class="feature-text">干预反馈</view>
      </view>
      <view class="feature-item">
        <view class="feature-icon feature-target">
          <view class="target-ring"></view>
          <view class="target-dot"></view>
        </view>
        <view class="feature-text">持续追踪</view>
      </view>
    </view>

    <view class="description">
      <text>按天记录短视频使用频次、时长和体验</text>
    </view>

    <view class="btn-section">
      <button class="start-btn" bindtap="goToForm" disabled="{{isLoading || (hasLogin && !canCheckinToday)}}">
        <text class="btn-text">{{isLoading ? '登录中...' : (experimentCompleted ? '已完成全部评估' : (todayCompleted ? '今日已完成' : (hasLogin ? '继续检测' : '开始检测')))}}</text>
        <text class="btn-arrow" wx:if="{{!isLoading && canCheckinToday}}">→</text>
      </button>
    </view>
  </view>

  <view class="consent-mask" wx:if="{{showInitialConsent}}" bindtap="onInitialConsentCancel">
    <view class="consent-modal" catchtap="onContentTap">
      <view class="consent-modal-title">实验说明</view>
      <scroll-view class="consent-modal-body" scroll-y>
        <view class="consent-project">欢迎来到{{projectName}}</view>
        <view class="consent-project-number">项目编号：{{projectNumber}}</view>
        <view class="consent-description">您将参加为期24天（前3天为基线期，后21天为干预期）的大学生短视频依赖心理干预实验活动。</view>
        <view class="consent-statement">“{{initialConsentText}}”</view>
        <view class="consent-check-row {{initialConsentChecked ? 'checked' : ''}}" bindtap="onInitialConsentToggle">
          <view class="consent-checkbox">{{initialConsentChecked ? '✓' : ''}}</view>
          <text>我已阅读并同意</text>
        </view>
      </scroll-view>
      <view class="consent-actions">
        <button class="consent-btn consent-cancel" bindtap="onInitialConsentCancel" disabled="{{isConsentSubmitting}}">暂不参加</button>
        <button class="consent-btn consent-confirm" bindtap="onInitialConsentConfirm" disabled="{{isConsentSubmitting}}">{{isConsentSubmitting ? '确认中...' : '同意并开始'}}</button>
      </view>
    </view>
  </view>
</view>