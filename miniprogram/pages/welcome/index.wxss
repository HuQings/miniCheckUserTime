.welcome-container {
  padding-left: 30rpx;
  padding-right: 30rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #667eea 0%, #5067ca 100%);
}

.content {
  padding-top: 160rpx;
}

.logo-section {
  text-align: center;
  margin-bottom: 50rpx;
}

.app-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.app-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.info-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.info-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  text-align: center;
}

.info-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.info-icon {
  font-size: 32rpx;
  margin-right: 15rpx;
  flex-shrink: 0;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.timeline {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  text-align: center;
}

.timeline-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.timeline-badge {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #667eea;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.timeline-content {
  flex: 1;
}

.timeline-phase {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.btn-section {
  padding: 40rpx 0;
}

.start-btn {
  width: 100%;
  background: linear-gradient(90deg, #ffd700 0%, #ffb347 100%);
  color: #333;
  border-radius: 50rpx;
  padding: 30rpx 0;
  font-size: 36rpx;
  font-weight: bold;
  border: none;
  box-shadow: 0 12rpx 32rpx rgba(255, 215, 0, 0.4);
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.98);
}

.project-info {
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 24rpx;
  margin-top: 40rpx;
}