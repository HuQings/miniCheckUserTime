page {
  min-height: 100%;
}

.welcome-container {
  position: relative;
  width: 100%;
  min-height: 100vh;
  overflow: hidden;
}

.gradient-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #673AB7 100%, #f093fb 0%);
  z-index: 0;
}

.content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  box-sizing: border-box;
  padding: 52rpx 40rpx 60rpx;
  animation: fadeIn 0.8s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.phone-icon {
  width: 180rpx;
  height: 180rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.15);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-20rpx);
  }
}

.phone-inner {
  width: 100rpx;
  height: 160rpx;
  background: #fff;
  border-radius: 20rpx;
  position: relative;
}

.phone-inner::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background: #e0e0e0;
  border-radius: 3rpx;
}

.app-name {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.app-slogan {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 300;
}

.user-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  padding: 32rpx 48rpx;
  margin-bottom: 25rpx;
  backdrop-filter: blur(10rpx);
  animation: fadeIn 0.5s ease-out;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-bottom: 16rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.login-status {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(76, 217, 100, 0.3);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

.checkin-section {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 36rpx;
  width: 100%;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 24rpx;
}

.progress-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.checkin-weeks {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.week-row {
  display: grid;
  grid-template-columns: 76rpx 1fr;
  align-items: center;
  column-gap: 16rpx;
}

.week-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  font-weight: 600;
  white-space: nowrap;
}

.week-days {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 10rpx;
}

.checkin-item {
  min-width: 0;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 18rpx;
  padding: 6rpx 0;
  transition: all 0.3s;
  box-sizing: border-box;
}

.checkin-item.completed {
  background: rgba(76, 217, 100, 0.3);
}

.checkin-item.current {
  background: rgba(255, 215, 0, 0.3);
  border: 2rpx solid rgba(255, 215, 0, 0.6);
}

.day-number {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
  margin-bottom: 6rpx;
  font-weight: 600;
}

.day-status {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
}

.checkin-item.completed .day-status {
  color: #4cd964;
  font-size: 28rpx;
}

.checkin-item.current .day-status {
  color: #ffd700;
  animation: pulse 1.5s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
}

.features {
  display: flex;
  justify-content: space-between;
  width: 100%;
  max-width: 500rpx;
  margin-bottom: 48rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.feature-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.22);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
}

.feature-chart {
  align-items: flex-end;
  gap: 8rpx;
  padding-bottom: 22rpx;
}

.chart-bar {
  width: 10rpx;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
  background: #fff;
}

.bar-one {
  height: 24rpx;
  opacity: 0.78;
}

.bar-two {
  height: 36rpx;
  opacity: 0.9;
}

.bar-three {
  height: 50rpx;
}

.feature-light {
  flex-direction: column;
}

.light-head {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50% 50% 44% 44%;
  background: #fff;
  position: relative;
}

.light-head::after {
  content: '';
  position: absolute;
  left: 12rpx;
  bottom: -10rpx;
  width: 14rpx;
  height: 14rpx;
  background: #fff;
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.light-base {
  width: 30rpx;
  height: 12rpx;
  margin-top: 10rpx;
  border-radius: 4rpx;
  background: rgba(255, 255, 255, 0.82);
}

.feature-target {
  border-radius: 50%;
}

.target-ring {
  width: 48rpx;
  height: 48rpx;
  border: 8rpx solid #fff;
  border-radius: 50%;
  box-sizing: border-box;
  position: relative;
}

.target-ring::after {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border: 5rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  box-sizing: border-box;
}

.target-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #fff;
}

.feature-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.description {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  margin-bottom: 48rpx;
  line-height: 1.6;
}

.btn-section {
  width: 100%;
  display: flex;
  justify-content: center;
}

.start-btn {
  width: 80%;
  max-width: 500rpx;
  height: 96rpx;
  background: #fff;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: none;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.2s, box-shadow 0.2s;
}

.start-btn::after {
  border: none;
}

.start-btn:active {
  transform: scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.btn-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #667eea;
  margin-right: 12rpx;
}

.btn-arrow {
  font-size: 40rpx;
  color: #667eea;
  transition: transform 0.2s;
}

.start-btn:active .btn-arrow {
  transform: translateX(8rpx);
}

.history-btn {
  width: 80%;
  max-width: 500rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 16rpx 0 0 0;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  transition: transform 0.2s, background 0.2s;
}

.history-btn::after {
  border: none;
}

.history-btn:active {
  transform: scale(0.96);
  background: rgba(255, 255, 255, 0.35);
}

.history-btn .btn-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #fff;
  margin-right: 8rpx;
}

.history-btn .btn-arrow {
  font-size: 36rpx;
  color: #fff;
}