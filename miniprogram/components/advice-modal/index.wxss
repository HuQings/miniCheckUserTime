.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 40rpx;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  padding: 40rpx 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-bottom: 2rpx solid #f0f0f0;
}

.header-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  flex: 1;
  padding: 32rpx 40rpx;
  overflow-y: auto;
}

.summary-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  color: #fff;
  width: 80%;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.summary-rating {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rating-text {
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.rating-emoji {
  font-size: 48rpx;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.95;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.advice-list {
  display: flex;
  width: 90%;
  flex-direction: column;
  gap: 24rpx;
}

.advice-item {
  background: #f8f9fc;
  border-radius: 20rpx;
  padding: 24rpx;
  border-left: 6rpx solid #667eea;
}

.advice-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.advice-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.advice-type {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.advice-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.advice-tag-high {
  background: #ffe0e0;
  color: #e54545;
}

.advice-tag-medium {
  background: #fff4e0;
  color: #f5a623;
}

.advice-tag-low {
  background: #e0f4ff;
  color: #1890ff;
}

.advice-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  margin-bottom: 12rpx;
}

.advice-tips {
  background: rgba(102, 126, 234, 0.08);
  border-radius: 12rpx;
  padding: 16rpx;
}

.tips-label {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.congrats-section {
  background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  margin-top: 24rpx;
}

.congrats-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.congrats-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.congrats-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.5;
}

.modal-footer {
  padding: 24rpx 40rpx 40rpx;
  display: flex;
  gap: 16rpx;
  border-top: 2rpx solid #f0f0f0;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  border: none;
}

.btn::after {
  border: none;
}

.btn-retry {
  background: #f0f0f0;
  color: #666;
}

.btn-close {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}

.btn-finish {
  background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
}

.btn:active {
  transform: scale(0.96);
}