.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-content {
  background: #fff;
  border-radius: 32rpx;
  width: 100%;
  max-width: 640rpx;
  max-height: 76vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(60rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.modal-header {
  position: relative;
  flex-shrink: 0;
  padding: 30rpx 40rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-bottom: 2rpx solid #f0f0f0;
  box-sizing: border-box;
}

.reflection-close {
  position: absolute;
  top: 22rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #fff0f4;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-line {
  position: absolute;
  width: 24rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #b85f7c;
}

.close-line-one {
  transform: rotate(45deg);
}

.close-line-two {
  transform: rotate(-45deg);
}

.header-icon {
  width: 88rpx;
  height: 88rpx;
  margin-bottom: 20rpx;
  border-radius: 28rpx;
  background: #fff0f4;
  border: 2rpx solid rgba(229, 143, 168, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.analysis-bars {
  height: 46rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.analysis-bar {
  width: 10rpx;
  border-radius: 5rpx 5rpx 2rpx 2rpx;
  background: #d56f91;
}

.bar-short {
  height: 20rpx;
  opacity: 0.65;
}

.bar-medium {
  height: 34rpx;
  opacity: 0.82;
}

.bar-tall {
  height: 46rpx;
}

.header-icon.is-final {
  border-radius: 50%;
  background: #e58fa8;
  border-color: #e58fa8;
}

.completion-check {
  width: 34rpx;
  height: 18rpx;
  border-left: 7rpx solid #fff;
  border-bottom: 7rpx solid #fff;
  transform: translateY(-4rpx) rotate(-45deg);
  box-sizing: border-box;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  flex: 1;
  width: 100%;
  min-height: 0;
  padding: 40rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.summary-card {
  background: linear-gradient(135deg, #e58fa8 0%, #d56f91 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  color: #fff;
  width: 80%;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.summary-rating {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.rating-text {
  font-size: 48rpx;
  font-weight: bold;
}

.summary-text {
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.95;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
}

.advice-list {
  display: flex;
  width: 100%;
  flex-direction: column;
  gap: 24rpx;
  box-sizing: border-box;
}

.reflection-body {
  padding: 34rpx 40rpx;
}

.reflection-section {
  margin-bottom: 32rpx;
}

.reflection-section:last-child {
  margin-bottom: 0;
}

.reflection-label {
  margin-bottom: 18rpx;
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.55;
}

.reflection-tip-title {
  margin-bottom: 8rpx;
  color: #c95f82;
  font-size: 28rpx;
  font-weight: 600;
}

.reflection-tip-text {
  margin-bottom: 18rpx;
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
}

.reflection-textarea {
  width: 100%;
  min-height: 190rpx;
  padding: 20rpx 22rpx;
  border: 2rpx solid #f0ced8;
  border-radius: 14rpx;
  background: #fff9fb;
  color: #333;
  font-size: 27rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

.advice-item {
  width: 100%;
  background: #fff9fb;
  border-radius: 20rpx;
  padding: 28rpx;
  border: 2rpx solid #f3d7df;
  box-sizing: border-box;
}

.advice-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.advice-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.advice-type {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.advice-tag {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.advice-tag-high {
  background: #ffe0e0;
  color: #e54545;
}

.advice-tag-medium {
  background: #fff4e0;
  color: #f5a623;
}

.advice-tag-low {
  background: #e0f4ff;
  color: #1890ff;
}

.advice-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.7;
}

.advice-tips {
  background: rgba(229, 143, 168, 0.12);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 20rpx;
}

.tips-label {
  font-size: 24rpx;
  color: #c95f82;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

.congrats-section {
  background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  text-align: center;
  margin-top: 24rpx;
}

.congrats-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.congrats-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.congrats-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.5;
}

.modal-footer {
  flex-shrink: 0;
  width: 100%;
  padding: 24rpx 40rpx 40rpx;
  display: flex;
  gap: 16rpx;
  border-top: 2rpx solid #f0f0f0;
  background: #fff;
  box-sizing: border-box;
}

.reflection-footer {
  padding-top: 28rpx;
}

.reflection-submit {
  background: linear-gradient(135deg, #e58fa8 0%, #d56f91 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(213, 111, 145, 0.28);
}

.reflection-submit[disabled] {
  background: #e6e1e3;
  color: #aaa;
  box-shadow: none;
  opacity: 1;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
  border: none;
}

.btn::after {
  border: none;
}

.btn-retry {
  background: #f0f0f0;
  color: #666;
}

.btn-close {
  background: linear-gradient(135deg, #e58fa8 0%, #d56f91 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(213, 111, 145, 0.3);
}

.btn-finish {
  background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 215, 0, 0.4);
}

.btn:active {
  transform: scale(0.96);
}