<view class="modal-mask" wx:if="{{show}}" bindtap="onMaskTap">
  <view class="modal-content" catchtap="onContentTap">
    <view class="modal-header">
      <view class="header-title">{{adviceData.resultType === 'previousIntervention' ? '昨日干预完成情况' : '分析结果'}}</view>
      <view
        class="reflection-close"
        wx:if="{{adviceData.resultType === 'previousIntervention'}}"
        bindtap="onReflectionClose"
        aria-label="关闭"
      >
        <view class="close-line close-line-one"></view>
        <view class="close-line close-line-two"></view>
      </view>
    </view>

    <scroll-view class="modal-body reflection-body" scroll-y wx:if="{{adviceData.resultType === 'previousIntervention'}}">
      <view class="reflection-section">
        <view class="reflection-label">针对你昨天的线下任务完成情况给出评价</view>
        <textarea
          class="reflection-textarea"
          maxlength="1000"
          placeholder="请输入你的评价"
          value="{{taskEvaluation}}"
          bindinput="onReflectionInput"
        ></textarea>
      </view>
      <view class="reflection-section">
        <view class="reflection-tip-title">小贴士</view>
        <view class="reflection-tip-text">请结合具体完成情况认真填写</view>
      </view>
    </scroll-view>

    <scroll-view class="modal-body" scroll-y wx:else>
      <view class="advice-list">
        <view class="advice-item" wx:for="{{adviceData.adviceList}}" wx:key="index">
          <view class="advice-content">{{item.content}}</view>
          <view class="advice-tips" wx:if="{{item.tips}}">
            <view class="tips-label">小贴士</view>
            <view class="tips-text">{{item.tips}}</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="modal-footer reflection-footer" wx:if="{{adviceData.resultType === 'previousIntervention'}}">
      <button
        class="btn reflection-submit"
        bindtap="onReflectionSubmit"
        disabled="{{!reflectionValid || isSubmitting}}"
      >{{isSubmitting ? '保存中...' : '完成'}}</button>
    </view>

    <view class="modal-footer" wx:else>
      <button class="btn btn-retry" bindtap="onRetry" wx:if="{{!adviceData.isFinal}}">
        <text>返回</text>
      </button>
      <button class="btn btn-finish" bindtap="onFinish" wx:if="{{adviceData.isFinal}}">
        <text>完成挑战</text>
      </button>
      <button class="btn btn-close" bindtap="onConfirm">
        <text>{{adviceData.isFinal ? '关闭' : '知道了'}}</text>
      </button>
    </view>
  </view>
</view>